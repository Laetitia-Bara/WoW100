rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth uid.
    //   - email: string or null (optional, private) - Account email.
    //   - displayName: string or null (optional, max 80) - Account display name.
    //   - photoUrl: string or null (optional, max 500) - Account avatar URL.
    //   - providerIds: list (optional, max 8) - Firebase Auth provider ids.
    //   - isPremium: bool (required, client create must be false, immutable by client) - Ad removal entitlement.
    //   - wallpaperPreference: string (optional, default|horde|alliance) - App background preference.
    //   - createdAt: timestamp (required, immutable) - Profile creation time.
    //   - updatedAt: timestamp (required) - Last profile refresh time.
    //
    // Subcollection: users/{uid}/settings
    // Document ID: mainCharacter
    // Fields:
    //   - name: string (required, max 80) - Character name.
    //   - level: int (required, 1..1000) - Character level.
    //   - realm: string (required, max 80) - Character realm.
    //   - race: string (required, max 80) - Character race.
    //   - characterClass: string (required, max 80) - Character class.
    //   - faction: string (required, max 32) - Character faction.
    //   - realmSlug: string (required, max 100) - Battle.net realm slug.
    //   - achievementPoints: int (required, 0..10000000) - Character achievement points.
    //   - mythicKeystoneRating: int (optional, 0..10000) - Mythic+ rating.
    //   - portraitUrl: string or null (optional, max 500) - Character portrait URL.
    //   - updatedAt: timestamp (required) - Last selected-character update time.
    //
    // Subcollection: users/{uid}/friends
    // Document ID: Battle.net friend storage key:
    //   lowercase region|lowercase realmSlug|lowercase character name.
    // Fields:
    //   - storageKey: string (required, immutable, max 240) - Must match the document ID.
    //   - region: string (required, max 8) - Battle.net region.
    //   - name: string (required, max 80) - Character name.
    //   - realm: string (required, max 80) - Character realm display name.
    //   - realmSlug: string (required, max 100) - Battle.net realm slug.
    //   - level: int (required, 0..1000) - Character level.
    //   - race: string (required, max 80) - Character race.
    //   - characterClass: string (required, max 80) - Character class.
    //   - faction: string (required, max 32) - Character faction.
    //   - guildName: string or null (optional, max 100) - Guild display name.
    //   - guildRealm: string or null (optional, max 80) - Guild realm display name.
    //   - guildRealmSlug: string or null (optional, max 100) - Guild realm slug.
    //   - achievementPoints: int (required, 0..10000000) - Character achievement points.
    //   - portraitUrl: string or null (optional, max 500) - Character portrait URL.
    //   - updatedAt: timestamp (required) - Last saved-friend update time.
    //
    // Collection: farmRoutes
    // Document ID: Auto-generated route id.
    // Fields:
    //   - ownerUid: string (required, immutable) - Firebase Auth uid of route owner.
    //   - ownerStorageKey: string (required, immutable, max 240) - Battle.net character key used for public friend lookup.
    //   - ownerCharacterName: string (required, max 80) - Owner character display name.
    //   - ownerRealm: string (optional, max 80) - Owner character realm display name.
    //   - ownerRealmSlug: string (optional, max 100) - Owner character realm slug.
    //   - ownerRegion: string (required, max 8) - Battle.net region.
    //   - name: string (required, max 80) - Saved route name.
    //   - visibility: string (required, private|public) - Route sharing mode.
    //   - itemIds: list (required, 1..250) - Catalog item ids included in the route.
    //   - createdAt: timestamp (required, immutable) - Route creation time.
    //   - updatedAt: timestamp (required) - Last route update time.
    //
    // Premium entitlement must be updated by trusted backend/admin code.
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validNullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validNullableUrl(value, maxLength) {
      return value == null ||
        (value is string &&
          value.size() <= maxLength &&
          (value.matches('^https://.*') || value.matches('^http://.*')));
    }

    function validWallpaperPreference(value) {
      return value is string &&
        (value == 'default' ||
          value == 'horde' ||
          value == 'alliance');
    }

    function validRouteVisibility(value) {
      return value is string &&
        (value == 'private' || value == 'public');
    }

    function hasValidUserShape(data, userId) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoUrl',
          'providerIds',
          'isPremium',
          'wallpaperPreference',
          'createdAt',
          'updatedAt',
        ]) &&
        data.keys().hasAll([
          'uid',
          'isPremium',
          'createdAt',
          'updatedAt',
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        (!('email' in data) || validNullableString(data.email, 320)) &&
        (!('displayName' in data) ||
          validNullableString(data.displayName, 80)) &&
        (!('photoUrl' in data) || validNullableUrl(data.photoUrl, 500)) &&
        (!('providerIds' in data) ||
          (data.providerIds is list &&
            data.providerIds.size() <= 8 &&
            data.providerIds.hasOnly([
              'password',
              'google.com',
              'apple.com',
            ]))) &&
        (!('wallpaperPreference' in data) ||
          validWallpaperPreference(data.wallpaperPreference)) &&
        data.isPremium is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserCreate(userId) {
      return hasValidUserShape(request.resource.data, userId) &&
        request.resource.data.isPremium == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidUserUpdate(userId) {
      return hasValidUserShape(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.isPremium == resource.data.isPremium &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    function hasValidMainCharacterShape(data) {
      return data.keys().hasOnly([
          'name',
          'level',
          'realm',
          'race',
          'characterClass',
          'faction',
          'realmSlug',
          'achievementPoints',
          'mythicKeystoneRating',
          'portraitUrl',
          'updatedAt',
        ]) &&
        data.keys().hasAll([
          'name',
          'level',
          'realm',
          'race',
          'characterClass',
          'faction',
          'realmSlug',
          'achievementPoints',
          'updatedAt',
        ]) &&
        validString(data.name, 80) &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 1000 &&
        validString(data.realm, 80) &&
        validString(data.race, 80) &&
        validString(data.characterClass, 80) &&
        validString(data.faction, 32) &&
        validString(data.realmSlug, 100) &&
        data.achievementPoints is int &&
        data.achievementPoints >= 0 &&
        data.achievementPoints <= 10000000 &&
        (!('mythicKeystoneRating' in data) ||
          (data.mythicKeystoneRating is int &&
            data.mythicKeystoneRating >= 0 &&
            data.mythicKeystoneRating <= 10000)) &&
        (!('portraitUrl' in data) ||
          validNullableUrl(data.portraitUrl, 500)) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function hasValidFriendShape(data, friendId) {
      return data.keys().hasOnly([
          'storageKey',
          'region',
          'name',
          'realm',
          'realmSlug',
          'level',
          'race',
          'characterClass',
          'faction',
          'guildName',
          'guildRealm',
          'guildRealmSlug',
          'achievementPoints',
          'portraitUrl',
          'updatedAt',
        ]) &&
        data.keys().hasAll([
          'storageKey',
          'region',
          'name',
          'realm',
          'realmSlug',
          'level',
          'race',
          'characterClass',
          'faction',
          'achievementPoints',
          'updatedAt',
        ]) &&
        validString(data.storageKey, 240) &&
        data.storageKey == friendId &&
        validString(data.region, 8) &&
        validString(data.name, 80) &&
        validString(data.realm, 80) &&
        validString(data.realmSlug, 100) &&
        data.level is int &&
        data.level >= 0 &&
        data.level <= 1000 &&
        validString(data.race, 80) &&
        validString(data.characterClass, 80) &&
        validString(data.faction, 32) &&
        (!('guildName' in data) || validNullableString(data.guildName, 100)) &&
        (!('guildRealm' in data) || validNullableString(data.guildRealm, 80)) &&
        (!('guildRealmSlug' in data) ||
          validNullableString(data.guildRealmSlug, 100)) &&
        data.achievementPoints is int &&
        data.achievementPoints >= 0 &&
        data.achievementPoints <= 10000000 &&
        (!('portraitUrl' in data) ||
          validNullableUrl(data.portraitUrl, 500)) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function hasValidFarmRouteShape(data) {
      return data.keys().hasOnly([
          'ownerUid',
          'ownerStorageKey',
          'ownerCharacterName',
          'ownerRealm',
          'ownerRealmSlug',
          'ownerRegion',
          'name',
          'visibility',
          'itemIds',
          'createdAt',
          'updatedAt',
        ]) &&
        data.keys().hasAll([
          'ownerUid',
          'ownerStorageKey',
          'ownerCharacterName',
          'ownerRegion',
          'name',
          'visibility',
          'itemIds',
          'createdAt',
          'updatedAt',
        ]) &&
        validString(data.ownerUid, 128) &&
        data.ownerUid == request.auth.uid &&
        validString(data.ownerStorageKey, 240) &&
        validString(data.ownerCharacterName, 80) &&
        (!('ownerRealm' in data) || validNullableString(data.ownerRealm, 80)) &&
        (!('ownerRealmSlug' in data) ||
          validNullableString(data.ownerRealmSlug, 100)) &&
        validString(data.ownerRegion, 8) &&
        validString(data.name, 80) &&
        validRouteVisibility(data.visibility) &&
        data.itemIds is list &&
        data.itemIds.size() > 0 &&
        data.itemIds.size() <= 250 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidFarmRouteCreate() {
      return hasValidFarmRouteShape(request.resource.data) &&
        request.resource.data.createdAt == request.time;
    }

    function isValidFarmRouteUpdate() {
      return hasValidFarmRouteShape(request.resource.data) &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerStorageKey == resource.data.ownerStorageKey &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isOwner(userId) && isValidUserUpdate(userId);
      allow delete: if false;

      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == 'mainCharacter';
        allow create, update: if isOwner(userId) &&
          settingId == 'mainCharacter' &&
          hasValidMainCharacterShape(request.resource.data);
        allow delete: if isOwner(userId) && settingId == 'mainCharacter';
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          hasValidFriendShape(request.resource.data, friendId);
        allow delete: if isOwner(userId);
      }
    }

    match /farmRoutes/{routeId} {
      allow read: if isAuthenticated() &&
        (resource.data.ownerUid == request.auth.uid ||
          resource.data.visibility == 'public');
      allow create: if isAuthenticated() && isValidFarmRouteCreate();
      allow update: if isAuthenticated() && isValidFarmRouteUpdate();
      allow delete: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
