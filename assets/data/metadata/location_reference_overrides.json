  "nameExclusionRules": [
    {
      "key": "name_contains_test",
      "continentKey": "eastern-kingdoms",
      "match": "test",
      "matchMode": "contains_case_insensitive",
      "reason": "Entrée technique contenant le mot Test, retirée avant la revue manuelle."
    },
    {
      "key": "name_contains_do_not_disturb",
      "continentKey": "eastern-kingdoms",
      "match": "[do not disturb]",
      "matchMode": "contains_case_insensitive",
      "reason": "Entrée technique marquée [DO NOT DISTURB], retirée avant la revue manuelle."
    },
    {
      "key": "name_contains_ne_pas_deranger",
      "continentKey": "eastern-kingdoms",
      "match": "[ne pas déranger]",
      "matchMode": "contains_case_insensitive",
      "reason": "Entrée technique marquée [NE PAS DÉRANGER], retirée avant la revue manuelle."
    },
    {
      "key": "name_contains_ne_pas_deranger_ascii",
      "continentKey": "eastern-kingdoms",
      "match": "[ne pas deranger]",
      "matchMode": "contains_case_insensitive",
      "reason": "Entrée technique marquée [NE PAS DERANGER], retirée avant la revue manuelle."
    },
    {
      "key": "name_contains_technical_marker",
      "continentKey": "eastern-kingdoms",
      "matches": [
        "[TEMP]",
        "BlizzCon",
        "(copy)",
        "[TEMP NAME]",
        "[ZONE DE DEV]",
        "Carte de dev",
        "Dev Area",
        "DemoArea",
        "UNUSED",
        "Demo Area",
        "dev1",
        "[DEVLAND COPY]",
        "prototype",
        "Terrain de jeu",
        "Terrain de jeux",
        "DEV LAND",
        "ZZ_AlexandraDD",
        "zzOLDBastion"
      ],
      "matchMode": "contains_any_case_insensitive",
      "reason": "Entrée technique correspondant à un marqueur de développement retiré avant la revue manuelle."
    }
  ],
